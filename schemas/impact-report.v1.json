{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:impact-report:v1",
  "title": "Stangent impact report (contract v1)",
  "description": "The answer to 'what does this change affect' (D27): grouped, labelled, summary first. Every ❓ is listed one by one.",
  "type": "object",
  "required": ["schemaVersion", "graph", "change", "groups", "unresolved", "hints", "requirements", "expanded"],
  "additionalProperties": false,
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "name", "kind", "label", "file", "line"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": { "enum": ["project", "file", "type", "method", "property", "field", "endpoint", "table", "column", "config"] },
        "label": { "enum": ["certain", "guessed"] },
        "file": { "type": ["string", "null"] },
        "line": { "type": "integer", "minimum": 0 }
      }
    },
    "group": {
      "type": "object",
      "required": ["name", "total", "certain", "guessed", "items", "more"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["change", "endpoints", "eventHandlers", "tables", "tests", "projects", "code"] },
        "total": { "type": "integer", "minimum": 0 },
        "certain": { "type": "integer", "minimum": 0 },
        "guessed": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
        "more": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "graph": {
      "type": "object",
      "required": ["commit"],
      "additionalProperties": false,
      "properties": { "commit": { "type": "string" } }
    },
    "change": {
      "type": "object",
      "required": ["kind", "value", "start"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["symbol", "file", "diff"] },
        "value": { "type": "string" },
        "start": { "$ref": "#/definitions/group" }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/group" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "reason", "in", "detector"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1 },
          "in": { "type": "string" },
          "detector": { "type": "string" }
        }
      }
    },
    "hints": { "description": "📜 usually-changes-together evidence (Phase 1c).", "type": "array" },
    "requirements": { "description": "Requirement IDs reached through trace links (Phase 2).", "type": "array" },
    "expanded": { "type": ["string", "null"] }
  }
}
