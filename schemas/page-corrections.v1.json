{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "page-corrections.v1.json",
  "title": "A person's corrections to reference pages (T.1, D131): recorded, approved, put back whenever the page is written",
  "type": "object",
  "required": ["schemaVersion", "corrections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "statement", "was", "kind", "why", "by", "state"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]{4,}$" },
          "page": { "type": "string" },
          "statement": { "type": "string", "description": "The statement's id when the correction was made." },
          "was": { "type": "string", "description": "The statement's words before it." },
          "kind": { "enum": ["replace", "remove"] },
          "text": { "type": "string", "description": "The words a person gave. Only for replace." },
          "why": { "type": "string" },
          "by": { "type": "string" },
          "state": { "enum": ["proposed", "approved", "rejected", "withdrawn"] },
          "approvedBy": { "type": "string" },
          "approvedAt": { "type": "string", "description": "The page's input hash when it was approved: a later one means the code moved under it." },
          "appliedTo": { "type": "string", "description": "The statement it's on now." },
          "notApplied": { "type": "boolean", "description": "The page was written again and neither the id nor the words are there." }
        }
      }
    }
  }
}
