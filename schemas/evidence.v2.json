{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:evidence:v2",
  "title": "Stangent evidence (contract v2)",
  "description": "One claim's proof: what it cites, at which version of the source, how strong it is, and who or what checked it (D113). The rules JSON Schema can't say are in EvidenceValidator: lines in order, checkedBy not empty unless a guess, `ran` needs more than an agent.",
  "type": "object",
  "required": ["id", "citation", "strength", "checkedBy"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Permanent: never renumbered or reused (see PermanentIds).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "citation": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["code", "document", "page", "test", "url"] },
        "ref": { "description": "repo/path, or a document id.", "type": "string", "minLength": 1 },
        "lines": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "end": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "symbol": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "attachment": { "description": "A document citation only: the quote is in this attachment of the document, not its text (D123).", "type": "string", "pattern": "^A-[0-9]{4,}$" },
        "file": { "description": "With attachment: the file it was found in, under the attachment's folder.", "type": "string", "minLength": 1 },
        "sheet": { "description": "With attachment: the workbook's sheet.", "type": "string", "minLength": 1 },
        "row": { "description": "With attachment: the sheet's row, which is the CSV file's line.", "type": "integer", "minimum": 1 },
        "note": { "description": "What a reader must know about these lines, such as a partial type's first part only.", "type": "string", "minLength": 1 }
      }
    },
    "commit": {
      "description": "The commit read: required for code and test citations.",
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "contentHash": {
      "description": "SHA-256 of the document read: required for document citations.",
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "strength": {
      "description": "ran: a test or run shows it. stated: a person or the FSD said it. read: read in the code only. guess: nothing backs it yet.",
      "enum": ["ran", "stated", "read", "guess"]
    },
    "checkedBy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["code", "agent", "person"] },
          "name": { "type": "string", "minLength": 1 },
          "inputsHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["commit"], "properties": { "citation": { "properties": { "kind": { "enum": ["code", "test"] } } } } },
    { "required": ["contentHash"], "properties": { "citation": { "properties": { "kind": { "enum": ["document"] } } } } },
    { "properties": { "citation": { "properties": { "kind": { "enum": ["page", "url"] } } } } }
  ]
}
