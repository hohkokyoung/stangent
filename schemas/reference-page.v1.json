{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:reference-page:v1",
  "title": "A reference page (contract reference-page v1, Phase 2a)",
  "description": "What one screen, shared component or backend entry point does, written by AI from its graph slice and checked by code (D52, D54, D18). Stored in specs/reference/<path>.json, rendered to .md beside it.",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "entry", "codeTitle", "title", "group", "sections", "unknowns", "verification", "generated"],
  "additionalProperties": false,
  "definitions": {
    "statement": {
      "type": "object",
      "required": ["id", "text", "cites"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[SARE][0-9]+$" },
        "text": { "type": "string", "minLength": 3 },
        "cites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "endpoints": { "type": "array", "items": { "type": "string", "pattern": "^endpoint:" } }
      }
    },
    "run": {
      "type": "object",
      "required": ["calls"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "calls": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cacheReadTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "ms": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "description": "page:<route> for a screen; the entry point's graph id otherwise (D54).", "type": "string", "minLength": 1 },
    "kind": { "enum": ["screen", "component", "backend"] },
    "entry": { "description": "The graph point the slice starts from.", "type": "string" },
    "codeTitle": { "description": "From the graph: the route and what it shows, or the entry point's name.", "type": "string" },
    "title": { "description": "From the writer: what a user would call it.", "type": "string" },
    "group": { "description": "The project the entry point belongs to.", "type": "string" },
    "sections": {
      "type": "object",
      "required": ["shows", "actions", "rules", "sideEffects"],
      "additionalProperties": false,
      "properties": {
        "shows": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
        "rules": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
        "sideEffects": { "type": "array", "items": { "$ref": "#/definitions/statement" } }
      }
    },
    "unknowns": {
      "description": "❓ What the slice couldn't see, appended by code (never by the AI).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "reason", "in"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" }, "line": { "type": "integer" }, "reason": { "type": "string" }, "in": { "type": "string" }
        }
      }
    },
    "verification": {
      "description": "The fresh verifier's findings (D62), each fixed or rejected with a reason.",
      "type": "object",
      "required": ["findings", "dropped"],
      "additionalProperties": false,
      "properties": {
        "dropped": { "description": "Findings dropped because their quote isn't in the slice.", "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement", "statementText", "kind", "explanation", "outcome", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^F[0-9]+$" },
              "statement": { "type": "string" },
              "statementText": { "type": "string" },
              "kind": { "enum": ["contradicted", "unsupported"] },
              "quote": { "type": "string" },
              "explanation": { "type": "string" },
              "outcome": { "enum": ["fixed", "rejected"] },
              "reason": { "type": "string" },
              "supportQuote": { "type": "string" }
            }
          }
        }
      }
    },
    "generated": {
      "type": "object",
      "required": ["commit", "bundleHash", "slice", "writer", "verifier", "checkRetries"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string" },
        "bundleHash": { "description": "The page's input hash (D18): unchanged means no AI call.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "slice": {
          "type": "object",
          "required": ["depth", "points", "chars", "cutOff"],
          "additionalProperties": false,
          "properties": {
            "depth": { "type": "integer" }, "points": { "type": "integer" }, "chars": { "type": "integer" },
            "cutOff": { "description": "Points one line past the depth limit, left out of the slice.", "type": "integer", "minimum": 0 }
          }
        },
        "writer": { "$ref": "#/definitions/run" },
        "verifier": { "$ref": "#/definitions/run" },
        "checkRetries": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
