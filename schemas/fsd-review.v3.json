{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:fsd-review:v3",
  "title": "specs/fsd/<doc>/review.json: the FSD review (contract fsd-review v3, D341, D366, D403)",
  "description": "The checked review runs of one FSD version against one commit, unioned by `stangent fsd review-merge`: exact duplicates joined, each finding saying which runs found it; findings that failed code's checks after the retry listed apart. Generated; answers and decisions don't go here.",
  "type": "object",
  "required": [
    "contract",
    "version",
    "doc",
    "commit",
    "fsdVersion",
    "model",
    "effort",
    "tokens",
    "costUsd",
    "runs",
    "counts",
    "findings",
    "dropped",
    "checklist"
  ],
  "additionalProperties": false,
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "state",
        "section",
        "fsdQuote",
        "screen",
        "note",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "gap",
            "conflict",
            "undocumented",
            "match"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "fsdQuote": {
          "type": [
            "string",
            "null"
          ]
        },
        "screen": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item": {
          "description": "D403: the checklist item this left-out finding is for (S03.012); absent on the AI's own findings.",
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "contract": {
      "const": "fsd-review"
    },
    "version": {
      "const": 3
    },
    "doc": {
      "type": "string"
    },
    "commit": {
      "description": "The commit the reviewers read (a worktree of HEAD).",
      "type": "string"
    },
    "fsdVersion": {
      "description": "The reviewed version's original hash, as document.json records it.",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run",
          "findings",
          "dropped",
          "retried",
          "usage"
        ],
        "additionalProperties": false,
        "properties": {
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "findings": {
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "retried": {
            "type": "boolean"
          },
          "usage": {
            "type": "object"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "gap",
        "conflict",
        "undocumented",
        "match"
      ],
      "additionalProperties": false,
      "properties": {
        "gap": {
          "type": "integer"
        },
        "conflict": {
          "type": "integer"
        },
        "undocumented": {
          "type": "integer"
        },
        "match": {
          "type": "integer"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/finding"
          }
        ],
        "type": "object",
        "required": [
          "id",
          "sectionId",
          "runs"
        ],
        "properties": {
          "id": {
            "description": "F-001 …, in section order; not permanent: a new merge numbers again.",
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "sectionId": {
            "description": "The section's permanent id (S-0001), or null.",
            "type": [
              "string",
              "null"
            ]
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "disagreesWith": {
            "description": "Findings of another run on the same section and quote in another state (a match one run, a conflict or gap the other): the runs disagree, and the difference is what gets ruled (D366).",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]{3,}$"
            }
          },
          "maybeSameAs": {
            "description": "Undocumented findings of another run in the same section with an evidence file in common: possibly the same difference, never joined by code.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run",
          "finding",
          "reasons"
        ],
        "additionalProperties": false,
        "properties": {
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "finding": {
            "$ref": "#/definitions/finding"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "checklist": {
      "description": "D403: every screen in scope and every control on it, listed by code from specs/inventory.json, and what came of each: covered by code (its name is in the FSD word for word), covered by the AI (a checked quote), left out (a finding) or not checked. Null when the runs had no inventory to list from.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "inventoryCommit",
        "listed",
        "coveredByCode",
        "coveredByAgent",
        "leftOut",
        "notChecked",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "inventoryCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "listed": {
          "type": "integer",
          "minimum": 0
        },
        "coveredByCode": {
          "type": "integer",
          "minimum": 0
        },
        "coveredByAgent": {
          "type": "integer",
          "minimum": 0
        },
        "leftOut": {
          "type": "integer",
          "minimum": 0
        },
        "notChecked": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "screen",
              "kind",
              "label",
              "code",
              "at",
              "result",
              "section",
              "fsdQuote",
              "byRun",
              "finding"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{2,}(\\.[0-9]{3,})?$"
              },
              "screen": {
                "description": "The screen's route.",
                "type": "string"
              },
              "kind": {
                "description": "screen, or the control's kind as the inventory gives it (button, field, menu-entry).",
                "type": "string"
              },
              "label": {
                "description": "The name the app shows, or the screen's title; null when it has none.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "description": "The control's name in the code.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "at": {
                "description": "Where the control is (path:line); null for a screen.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "section": {
                "description": "For code or covered: the section that names or describes it; for left-out, the section the AI gave, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "fsdQuote": {
                "description": "For covered: the FSD sentence the AI quoted (checked word for word).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "byRun": {
                "description": "Each run's outcome, in run order.",
                "type": "array",
                "items": {
                  "enum": [
                    "code",
                    "covered",
                    "left-out",
                    "not-checked"
                  ]
                }
              },
              "finding": {
                "description": "For left-out: its finding's id.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "result": {
                "enum": [
                  "code",
                  "covered",
                  "left-out",
                  "not-checked"
                ]
              }
            }
          }
        }
      }
    }
  }
}
