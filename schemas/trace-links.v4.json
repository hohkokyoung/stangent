{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:trace-links:v4",
  "title": "FSD ↔ reference page links and findings (contract trace-links v4, Phases 2b, 2c)",
  "description": "specs/trace.yaml (D58), read as JSON. v2 added the requirement a link belongs to (D99). v3 adds what a finding carries (D118): its permanent id, its severity and who set it, and its evidence, each record checked by EvidenceValidator; files written by v1 and v2 still read. One entry per link or finding: both ends, the state, both quotes and their hashes, and the decision people make. decided_by comes from git, never typed. v4 adds the section's permanent id beside its number (D121): filled and kept right by code at trace check, read by no hash. It also holds, unshipped until this version merges (D122): the decisions accepted and not-a-difference, and a finding's standing.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "version": {
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "fsd",
          "page",
          "by",
          "decision",
          "decided_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L[0-9a-f]{10}$"
          },
          "state": {
            "enum": [
              "agree",
              "gap",
              "conflict",
              "undocumented",
              "partial",
              "unclear",
              "table-fact"
            ]
          },
          "fsd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "doc",
                  "section"
                ],
                "additionalProperties": false,
                "properties": {
                  "doc": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  },
                  "attachment": {
                    "description": "The quote is from this attachment of the section, not its text, found by code (D123).",
                    "type": "string",
                    "pattern": "^A-[0-9]{4,}$"
                  },
                  "attachmentFile": {
                    "description": "The file the quote is in, under the attachment's folder.",
                    "type": "string"
                  },
                  "attachmentSheet": {
                    "description": "The workbook's sheet, for a CSV file.",
                    "type": "string"
                  },
                  "attachmentRow": {
                    "description": "The sheet's row, which is the CSV file's line. Kept up to date by trace check.",
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "sectionId": {
                    "description": "The section's permanent id (D117, D121). `section` stays, because entry ids and saved hashes are built from it.",
                    "type": "string",
                    "pattern": "^S-[0-9]{4,}$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "requirement": {
                    "description": "The requirement this link judges, when the section's requirements were built (D99).",
                    "type": "string",
                    "pattern": "^R-[0-9]{4,}$"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "quoteHash": {
                    "$ref": "#/definitions/hash"
                  }
                }
              }
            ]
          },
          "page": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "statement": {
                    "type": "string",
                    "pattern": "^[SARE][0-9]+$"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "quoteHash": {
                    "$ref": "#/definitions/hash"
                  }
                }
              }
            ]
          },
          "by": {
            "description": "judge: the link judge proposed it (and, for agree, a second fresh check confirmed or disputed it); code: found by code.",
            "enum": [
              "judge",
              "code"
            ]
          },
          "check": {
            "enum": [
              "confirmed",
              "disputed"
            ]
          },
          "note": {
            "type": "string"
          },
          "decision": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "agree",
                  "code-wrong",
                  "fsd-wrong",
                  "page-wrong",
                  "defer",
                  "accepted",
                  "not-a-difference"
                ]
              }
            ]
          },
          "decided_by": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "partial": {
            "description": "On a partial link only (C.4, D124): what the page's statement covers and what it leaves out, from the judge.",
            "type": "object",
            "required": ["covered", "missing"],
            "additionalProperties": false,
            "properties": { "covered": { "type": "string" }, "missing": { "type": "string" } }
          },
          "table_fact": {
            "description": "On a table-fact finding only (C.2, D124): what code compared. Written by code; the route says this came by comparing a table with the code, not through a page. Its evidence is the table's cell, stated, and the code's lines, read.",
            "type": "object",
            "required": ["route", "result", "table", "column", "row", "kind", "target", "strength", "key"],
            "additionalProperties": false,
            "properties": {
              "route": { "const": "table-facts" },
              "result": { "enum": ["differs", "fsd-only", "code-only"] },
              "table": { "type": "string", "pattern": "^[TA]-[0-9]{4,}$" },
              "sheet": { "type": "string" },
              "column": { "type": "string" },
              "row": { "type": "integer", "minimum": 1 },
              "kind": { "enum": ["api-field", "enum-member"] },
              "target": { "type": "string" },
              "strength": { "const": "read" },
              "key": { "type": "string" },
              "fsdName": { "type": "string" },
              "fsdValue": { "type": "string" },
              "codeName": { "type": "string" },
              "codeValue": { "type": "string" },
              "symbol": { "type": "string" },
              "path": { "type": "string" },
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "linesNot": { "type": "string" }
            }
          },
          "decided_on": {
            "description": "The hash of the page statement's normalised text when the decision was made, written by code. If the text changes, the decision drops back. No input hash reads it.",
            "$ref": "#/definitions/hash"
          },
          "finding": {
            "description": "Permanent, issued by trace check from specs/trace-ids.json. Only a finding has one.",
            "type": "string",
            "pattern": "^X-[0-9]{4,}$"
          },
          "severity": {
            "description": "A person sets it, in a PR. Starts ungraded. See Severity in Core.",
            "enum": [
              "blocker",
              "major",
              "minor",
              "cosmetic",
              "ungraded"
            ]
          },
          "severity_by": {
            "description": "Comes from git after merge, as decided_by does; never typed.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "evidence": {
            "description": "Records of contract evidence v1, derived again by trace check from what's current. Nobody types them.",
            "type": "array"
          },
          "evidence_hash": {
            "description": "The hash of the evidence as code last wrote it, so a record that differs is told apart from one that's only out of date.",
            "$ref": "#/definitions/hash"
          },
          "verdict": {
            "description": "The disprove step's answer, written by code once its quote passes (D119). No field means unverified.",
            "enum": [
              "stands",
              "refuted",
              "page-gap",
              "unreachable",
              "cant-tell"
            ]
          },
          "disproof": {
            "description": "What the verdict rests on. `inputs` is the hash of the bundle it was judged from; a changed bundle drops the verdict back.",
            "type": "object",
            "required": [
              "inputs",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "$ref": "#/definitions/hash"
              },
              "why": {
                "type": "string"
              },
              "bundle": {
                "description": "`small`: judged from a smaller bundle (disprove-small, I.3), watched against cant-tell. Absent otherwise.",
                "enum": ["small"]
              },
              "agent": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              },
              "quote": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "suggestedSeverity": {
                "description": "The agent's suggestion, shown beside `severity`. A person still sets it (D118).",
                "enum": [
                  "blocker",
                  "major",
                  "minor",
                  "cosmetic"
                ]
              },
              "claimed": {
                "description": "What the agent answered when its quote failed twice and code wrote cant-tell.",
                "enum": [
                  "stands",
                  "refuted",
                  "page-gap",
                  "unreachable",
                  "cant-tell"
                ]
              }
            }
          },
          "disproof_hash": {
            "description": "The hash of the verdict and disproof as code wrote them.",
            "$ref": "#/definitions/hash"
          },
          "review": {
            "description": "A person's word on a verdict (D119): confirmed closes a refuted or unreachable finding; sent-back returns a finding to the BA. No field means waiting.",
            "enum": [
              "confirmed",
              "sent-back"
            ]
          },
          "review_note": {
            "description": "Who and why. `by` is from git, and missing when code sent it back because a decision dropped. `on` is the hash of the statement's text it was confirmed on.",
            "type": "object",
            "required": [
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "by": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "on": {
                "$ref": "#/definitions/hash"
              }
            }
          },
          "review_hash": {
            "description": "The hash of the review, its note and the verdict's disproof_hash as code wrote them.",
            "$ref": "#/definitions/hash"
          },
          "standing": {
            "description": "What happened to a decided finding, written by code (D122). recheck: its decision dropped because what it rested on changed, or it came back after being gone. gone: a new build no longer finds it. It's kept, listed and in no reader's lists. No field means current.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "recheck",
                  "gone"
                ]
              }
            ]
          },
          "standing_note": {
            "description": "The decision it had and who made it, so it stays visible, and why it moved.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "why"
                ],
                "additionalProperties": false,
                "properties": {
                  "was": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "standing_hash": {
            "description": "The hash of the standing and its note as code wrote them.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/hash"
              }
            ]
          }
        }
      }
    }
  }
}
