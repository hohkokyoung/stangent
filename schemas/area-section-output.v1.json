{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "area-section-output",
  "description": "One section of an area's page in plain words (layer 4, D251–D254): paragraphs of sentences, each citing the code's items and marking each cited item's conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["paragraphs"],
  "properties": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences"],
        "properties": {
          "lead": { "type": "string", "description": "An optional short lead-in, two to five words." },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "items", "conditions"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "items": { "type": "array", "items": { "type": "string" } },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["item", "condition", "is"],
                    "properties": {
                      "item": { "type": "string" },
                      "condition": { "type": "integer", "minimum": 1 },
                      "is": { "enum": ["said", "always"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
