{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stangent:schema:page-writer-output:v1",
  "title": "What stangent-page-writer returns (Phase 2, D60)",
  "description": "One reference page as the writer subagent writes it. Code numbers the statements, checks every citation against the page's slice, and records it as a reference-page (v1).",
  "type": "object",
  "required": ["title", "shows", "actions", "rules", "sideEffects"],
  "additionalProperties": false,
  "definitions": {
    "statement": {
      "type": "object",
      "required": ["text", "cites"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 3, "maxLength": 400 },
        "cites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "action": {
      "type": "object",
      "required": ["text", "cites"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 3, "maxLength": 400 },
        "cites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "endpoints": { "description": "Endpoint ids from the slice that this action calls.", "type": "array", "items": { "type": "string", "pattern": "^endpoint:" } }
      }
    }
  },
  "properties": {
    "title": { "description": "What a user or BA would call this page, in a few words.", "type": "string", "minLength": 1, "maxLength": 80 },
    "shows": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "sideEffects": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "resolutions": {
      "description": "Only when fixing after a verifier's findings: one per finding.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "outcome", "reason"],
        "additionalProperties": false,
        "properties": {
          "finding": { "type": "string", "pattern": "^F[0-9]+$" },
          "outcome": { "enum": ["fixed", "rejected"] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 600 },
          "quote": { "description": "Rejecting an 'unsupported' finding: the source line in the slice that supports the statement, copied exactly.", "type": "string" }
        }
      }
    }
  }
}
