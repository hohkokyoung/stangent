        "id": "A1",
        "text": "Sets the monitored flag of the given episode ids to the requested value. A single id is handled as a single-episode update; several ids are updated together."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Api.V3|M:Sonarr.Api.V3.Episodes.EpisodeController.SetEpisodesMonitored(Sonarr.Api.V3.Episodes.EpisodesMonitoredResource,System.Boolean)"
        ],
        "id": "R1",
        "text": "The request body is JSON with a list of episode ids and a monitored value. An optional includeImages query parameter defaults to false."
      },
      {
        "cites": [
          "Sonarr.Api.V3|M:Sonarr.Api.V3.Episodes.EpisodeController.SetEpisodesMonitored(Sonarr.Api.V3.Episodes.EpisodesMonitoredResource,System.Boolean)"
        ],
        "id": "R2",
        "text": "When exactly one episode id is supplied, the single-episode path is used. Otherwise the bulk path is used."
      }
    ],
    "shows": [
