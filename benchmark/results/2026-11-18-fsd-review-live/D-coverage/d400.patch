+        state.Remove("askedCoverage");
+        state.Remove("screens");
+        File.WriteAllText(statePath, state.ToJsonString());
+        AnswerWith(1, null, F("gap", "1", "Orders ship within two days of payment.", null, "No shipping deadline.", "src/orders.ts:3"));
+        var step = FsdReview.Check(Repo, "shop", 1, null);
+        Assert.Equal("recorded", step.Status);
+        Assert.Null(Checked(1)["uncovered"]);
+    }
 }
