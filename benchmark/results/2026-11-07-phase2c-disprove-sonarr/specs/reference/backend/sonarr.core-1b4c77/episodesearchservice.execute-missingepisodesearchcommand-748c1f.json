        ],
        "id": "A1",
        "text": "Runs a missing-episode search for the command: it selects missing episodes, drops those already in the download queue, and searches indexers for the rest."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.SearchForBulkEpisodes(System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},System.Boolean,System.Boolean)"
        ],
        "id": "A2",
        "text": "Groups the episodes by series and season. A group with more than one episode gets a season search; a group with one episode gets an episode search."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)",
          "Sonarr.Common|M:NzbDrone.Common.Extensions.DateTimeExtensions.Before(System.DateTime,System.DateTime)"
        ],
        "id": "R1",
        "text": "When the command has a series id, episodes come from that series. They must have the command's monitored value, have no file, have an air date, and have aired (air date is now or earlier)."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)"
        ],
        "id": "R2",
        "text": "Without a series id, episodes without files are loaded across all series, specials included, sorted by Id ascending in a single page of 1,000,000."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)"
        ],
        "id": "R3",
        "text": "If monitored is true, only episodes that are monitored and whose series is monitored are included. Otherwise, episodes that are unmonitored or belong to an unmonitored series are included."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)"
        ],
        "id": "R4",
        "text": "Optional filters narrow the episodes by series ids, quality profile ids and series type when given. Series tags are passed to the missing-episode query."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)",
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.GetQueuedEpisodeIds"
        ],
        "id": "R5",
        "text": "Episodes already in the download queue are excluded from the search."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.Execute(NzbDrone.Core.IndexerSearch.MissingEpisodeSearchCommand)"
        ],
        "id": "R6",
        "text": "The search counts as user-invoked only when the command trigger is Manual."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.SearchForBulkEpisodes(System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},System.Boolean,System.Boolean)"
        ],
        "id": "R7",
        "text": "Groups are searched in order of their oldest last-search time, with never-searched episodes first."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.EpisodeSearchService.SearchForBulkEpisodes(System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},System.Boolean,System.Boolean)"
        ],
        "id": "R8",
        "text": "If a search for a group fails, the error is logged and that group is skipped. The remaining groups continue."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.IndexerSearch.ReleaseSearchService.EpisodeSearch(NzbDrone.Core.Tv.Episode,System.Boolean,System.Boolean)"
