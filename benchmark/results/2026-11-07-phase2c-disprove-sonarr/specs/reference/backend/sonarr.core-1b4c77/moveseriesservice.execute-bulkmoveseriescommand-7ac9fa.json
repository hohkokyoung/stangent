        ],
        "id": "A1",
        "text": "Executing the bulk move command moves each listed series, in order, from its source path to a folder under the destination root folder."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.Execute(NzbDrone.Core.Tv.Commands.BulkMoveSeriesCommand)",
          "Sonarr.Core|M:NzbDrone.Core.Organizer.IBuildFileNames.GetSeriesFolder(NzbDrone.Core.Tv.Series,NzbDrone.Core.Organizer.NamingConfig)"
        ],
        "id": "R1",
        "text": "The destination path of each series is the destination root folder combined with the series folder name built from the series by the file name builder."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.MoveSingleSeries(NzbDrone.Core.Tv.Series,System.String,System.String,System.Nullable{System.Int32},System.Nullable{System.Int32})",
          "Sonarr.Common|M:NzbDrone.Common.Extensions.PathExtensions.IsPathValid(System.String,NzbDrone.Common.Disk.PathValidationType)"
        ],
        "id": "R2",
        "text": "If the source path is not valid for the current OS, nothing is moved; a warning is logged and the series path is set to the destination path."
      },
      {
        "cites": [
          "Sonarr.Common|M:NzbDrone.Common.Extensions.PathExtensions.IsPathValid(System.String,NzbDrone.Common.Disk.PathValidationType)"
        ],
        "id": "R3",
        "text": "A path is invalid if empty/whitespace, has invalid characters or path traversal, or (on Windows) has leading/trailing spaces in it or any parent folder name."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.MoveSingleSeries(NzbDrone.Core.Tv.Series,System.String,System.String,System.Nullable{System.Int32},System.Nullable{System.Int32})",
          "Sonarr.Common|M:NzbDrone.Common.Disk.IDiskProvider.FolderExists(System.String)"
        ],
        "id": "R4",
        "text": "If the source folder does not exist, no move happens and the series path is updated to the destination path anyway; it is logged as a completed move if the destination exists, otherwise as a warning."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.MoveSingleSeries(NzbDrone.Core.Tv.Series,System.String,System.String,System.Nullable{System.Int32},System.Nullable{System.Int32})",
          "Sonarr.Common|M:NzbDrone.Common.Extensions.PathExtensions.PathEquals(System.String,System.String,System.Nullable{System.StringComparison})"
        ],
        "id": "R5",
        "text": "If the source and destination paths are equal, no move happens; the series path is set to the destination."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.MoveSingleSeries(NzbDrone.Core.Tv.Series,System.String,System.String,System.Nullable{System.Int32},System.Nullable{System.Int32})"
        ],
        "id": "R6",
        "text": "If the move fails with an IO error, the series path is set back to the source path and the error is logged. Any other exception also resets the path to the source and is rethrown."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Tv.MoveSeriesService.UpdatePath(System.Int32,System.String)"
        ],
        "id": "R7",
        "text": "Updating a series path sets its Path to the new path and clears its PendingPath."
      }
    ],
    "shows": [
      {
