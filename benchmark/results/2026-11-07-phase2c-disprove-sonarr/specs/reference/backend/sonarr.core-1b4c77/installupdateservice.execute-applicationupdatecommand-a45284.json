        ],
        "id": "A1",
        "text": "Runs the application update: looks for an available update and, if one is allowed, downloads, verifies, extracts and installs it, then logs that Sonarr is restarting to apply updates."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Update.InstallUpdateService.GetUpdatePackage(NzbDrone.Core.Messaging.Commands.CommandTrigger,System.Boolean)",
          "Sonarr.Core|M:NzbDrone.Core.Update.CheckUpdateService.AvailableUpdate"
        ],
        "id": "R1",
        "text": "No update is installed when none is available for the configured branch and current version."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Update.InstallUpdateService.GetUpdatePackage(NzbDrone.Core.Messaging.Commands.CommandTrigger,System.Boolean)"
        ],
        "id": "R2",
        "text": "A major version update is skipped unless the command allows installing major updates; the user is told to update manually from System: Updates."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Update.InstallUpdateService.GetUpdatePackage(NzbDrone.Core.Messaging.Commands.CommandTrigger,System.Boolean)"
        ],
        "id": "R3",
        "text": "If automatic updates are not enabled, the update is only installed when the command was triggered manually."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Update.InstallUpdateService.GetUpdatePackage(NzbDrone.Core.Messaging.Commands.CommandTrigger,System.Boolean)"
        ],
        "id": "R4",
        "text": "The built-in updater is disabled inside a docker container, and when an external update mechanism is in use. With an external mechanism, only the Script update mechanism can still install."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Update.InstallUpdateService.EnsureAppDataSafety",
