        "id": "A1",
        "text": "Removes a queue item by id. Options: removeFromClient, blocklist, skipRedownload, changeCategory."
      },
      {
        "cites": [
          "Sonarr.Api.V3|M:Sonarr.Api.V3.Queue.QueueController.RemoveAction(System.Int32,System.Boolean,System.Boolean,System.Boolean,System.Boolean)",
          "Sonarr.Api.V3|M:Sonarr.Api.V3.Queue.QueueController.Remove(NzbDrone.Core.Queue.Queue,System.Boolean)"
        ],
        "id": "A2",
        "text": "If the id matches a pending release, it is removed (and optionally blocklisted) and nothing else happens."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Api.V3|M:Sonarr.Api.V3.Queue.QueueController.RemoveAction(System.Int32,System.Boolean,System.Boolean,System.Boolean,System.Boolean)"
        ],
        "id": "R1",
        "text": "Defaults: removeFromClient true, blocklist false, skipRedownload false, changeCategory false."
      },
      {
