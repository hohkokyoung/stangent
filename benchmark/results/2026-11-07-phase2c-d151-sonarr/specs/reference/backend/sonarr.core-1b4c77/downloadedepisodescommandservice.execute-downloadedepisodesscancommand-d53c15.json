        ],
        "id": "A2",
        "text": "When a download client id is supplied and a matching tracked download is known, imports the path for that download's series and download item, then verifies the import against the tracked download."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.MediaFiles.DownloadedEpisodesCommandService.Execute(NzbDrone.Core.MediaFiles.Commands.DownloadedEpisodesScanCommand)"
        ],
        "id": "R1",
        "text": "A path is required; if it is null or whitespace the command throws an ArgumentException \"A path must be provided\"."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.MediaFiles.DownloadedEpisodesCommandService.ProcessPath(NzbDrone.Core.MediaFiles.Commands.DownloadedEpisodesScanCommand)"
        ],
        "id": "R2",
        "text": "If the path is neither an existing folder nor an existing file, a warning is logged and nothing is imported."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.MediaFiles.DownloadedEpisodesCommandService.ProcessPath(NzbDrone.Core.MediaFiles.Commands.DownloadedEpisodesScanCommand)"
        ],
        "id": "R3",
        "text": "If a download client id is given but no tracked download is found, a warning is logged and a normal import of the path is attempted using the command's import mode."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.MediaFiles.DownloadedEpisodesCommandService.Execute(NzbDrone.Core.MediaFiles.Commands.DownloadedEpisodesScanCommand)"
        ],
        "id": "R4",
        "text": "If there are no import results or none has result Imported, the command logs \"Failed to import\" and reports the result as Unsuccessful, but still completes without error."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Download.CompletedDownloadService.VerifyImport(NzbDrone.Core.Download.TrackedDownloads.TrackedDownload,System.Collections.Generic.List{NzbDrone.Core.MediaFiles.EpisodeImport.ImportResult})"
        ],
        "id": "R5",
        "text": "A download counts as fully imported when imported episodes number at least the larger of 1 and the release's episode count, or when history shows all its episodes already imported."
      },
      {
        "cites": [
