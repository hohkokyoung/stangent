        ],
        "id": "R4",
        "text": "When the import replaced old files, the notification is sent only if its On Upgrade option is enabled; with no old files it is always sent."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.Handle(NzbDrone.Core.MediaFiles.Events.EpisodeImportedEvent)"
        ],
        "id": "R5",
        "text": "A failure in one notification is logged as a warning and does not stop the others."
      }
