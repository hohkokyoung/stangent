    "shows": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.Handle(NzbDrone.Core.MediaFiles.Events.EpisodeImportedEvent)"
        ],
        "id": "S1",
        "text": "Builds a download message containing a summary text, the series, episode info, imported episode file, old files, source path, download client info, download id and release."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.GetMessage(NzbDrone.Core.Tv.Series,System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},NzbDrone.Core.Qualities.QualityModel)"
