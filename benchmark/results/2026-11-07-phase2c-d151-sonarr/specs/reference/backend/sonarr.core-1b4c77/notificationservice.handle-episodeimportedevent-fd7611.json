      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.GetMessage(NzbDrone.Core.Tv.Series,System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},NzbDrone.Core.Qualities.QualityModel)"
        ],
        "id": "S3",
        "text": "For daily series the summary text is \"Series - air date - episode title [quality]\" using the first episode."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.GetMessage(NzbDrone.Core.Tv.Series,System.Collections.Generic.List{NzbDrone.Core.Tv.Episode},NzbDrone.Core.Qualities.QualityModel)"
        ],
        "id": "S4",
        "text": "For other series the summary text is \"Series - season + xNN episode numbers - titles joined by ' + ' [quality]\"."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.GetQualityString(NzbDrone.Core.Tv.Series,NzbDrone.Core.Qualities.QualityModel)"
        ],
        "id": "S5",
        "text": "The quality string is the quality name; when the revision version is above 1 it appends \" v<version>\" for anime series and \" Proper\" for others."
      }
    ],
