        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Blocklisting.BlocklistService.Handle(NzbDrone.Core.Download.DownloadFailedEvent)"
        ],
        "id": "R5",
        "text": "The blocklist date is the current UTC time."
