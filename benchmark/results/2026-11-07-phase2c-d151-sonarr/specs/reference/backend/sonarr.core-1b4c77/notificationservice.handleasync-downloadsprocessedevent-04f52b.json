        "id": "A1",
        "text": "When a downloads-processed event arrives, the service processes the queued updates of every available notification provider."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationService.ProcessQueue"
        ],
        "id": "R1",
        "text": "If processing one notification's queue throws, a warning 'Unable to process notification queue for <name>' is logged and the remaining notifications are still processed."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.NotificationBase`1.ProcessQueue"
        ],
        "id": "R2",
        "text": "By default a notification's ProcessQueue does nothing; only providers that override it act."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Emby.MediaBrowser.ProcessQueue"
        ],
        "id": "R3",
        "text": "Emby/MediaBrowser updates the library only when UpdateLibrary is enabled in its settings."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Emby.MediaBrowser.ProcessQueue"
        ],
        "id": "R4",
        "text": "For Emby, if a series has exactly one update type that type is sent; otherwise no update type is sent and Emby decides."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Plex.Server.PlexServer.ProcessQueue"
        ],
        "id": "R5",
        "text": "Plex Server updates the library only when UpdateLibrary is enabled in its settings."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Xbmc.Xbmc.ProcessQueue"
        ],
        "id": "R6",
        "text": "Kodi (Xbmc) updates the library for each queued series only when UpdateLibrary is enabled."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Xbmc.Xbmc.ProcessQueue"
        ],
        "id": "R7",
        "text": "Kodi cleans the library only when the queued item's info contains true and CleanLibrary is enabled."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Xbmc.Xbmc.ProcessQueue"
        ],
        "id": "R8",
        "text": "If Kodi cannot be reached (socket error), a debug message 'Unable to connect to Kodi Host: host:port' is logged and processing continues."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Emby.MediaBrowser.ProcessQueue",
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Plex.Server.PlexServer.ProcessQueue",
          "Sonarr.Core|M:NzbDrone.Core.Notifications.Xbmc.Xbmc.ProcessQueue"
        ],
        "id": "R9",
        "text": "Queued items are processed per configured host (Settings.Host) for Emby, Plex and Kodi."
      }
    ],
