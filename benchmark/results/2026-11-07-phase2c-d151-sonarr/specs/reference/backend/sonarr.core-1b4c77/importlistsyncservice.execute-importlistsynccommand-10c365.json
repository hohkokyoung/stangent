        "id": "A1",
        "text": "When the command carries a definition id, syncs only that import list; otherwise syncs all lists with automatic add enabled."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.SyncAll"
        ],
        "id": "A2",
        "text": "A full sync fetches items from all automatic-add lists, processes them, removes synced tags from series no longer on lists, then tries to clean the library."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.SyncList(NzbDrone.Core.ImportLists.ImportListDefinition)"
        ],
        "id": "A3",
        "text": "A single-list sync fetches that list, processes its items, removes synced tags, then tries to clean the library."
      }
    ],
    "rules": [
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.SyncAll"
        ],
        "id": "R1",
        "text": "A full sync does nothing (logs \"No import lists with automatic add enabled\") if no list has automatic add enabled."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListFactory.AutomaticAddEnabled(System.Boolean)",
