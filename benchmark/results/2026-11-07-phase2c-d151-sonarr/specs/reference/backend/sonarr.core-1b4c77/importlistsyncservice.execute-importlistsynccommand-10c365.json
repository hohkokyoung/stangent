      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.FetchAndParseImportListService.Fetch"
        ],
        "id": "R3",
        "text": "A list is skipped in a full fetch if its last sync plus its minimum refresh interval is still in the future."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R4",
        "text": "Items from lists that do not have automatic add enabled are ignored."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R5",
        "text": "An item without a TVDB id is mapped by IMDb id, then TMDb id, then AniList id, then MAL id. Items with an AniList or MAL id that can't be mapped are rejected."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R6",
        "text": "Items still without a TVDB id (0) are rejected."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R7",
        "text": "Items whose TVDB id is in the list exclusions are rejected."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})",
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.QueueTagsOnPendingSeries(NzbDrone.Core.ImportLists.ImportListDefinition,System.Collections.Generic.Dictionary{System.Int32,System.Collections.Generic.HashSet{System.Int32}},System.Int32)"
        ],
        "id": "R8",
        "text": "Series already in the library are not added again. Their tags are queued for update only if the list's tag-existing setting is not None and the list has tags."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R9",
        "text": "A new series takes its settings from the list: root folder, quality profile, series type, language, season folder, tags, monitor-new-items and search-for-missing-episodes. It is monitored unless the list's monitor type is None."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R10",
        "text": "If an item provides seasons, the add monitor option is Skip; otherwise the list's monitor setting is used."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.ProcessListItems(System.Collections.Generic.List{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R11",
        "text": "If a series is already queued to add from another list, that list's tags are added to the queued series instead of adding it twice."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.RemoveTagsFromSeriesNotOnLists",
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.HasSyncedSuccessfully(System.Int32)"
        ],
        "id": "R12",
        "text": "A tag is removed from a series only if its list has tag-existing type Sync, every automatic-add list with that tag synced successfully (not disabled and synced before), and the series is on none of those lists."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.IsSeriesOnList(NzbDrone.Core.Tv.Series,System.Collections.Generic.IEnumerable{NzbDrone.Core.Parser.Model.ImportListItemInfo})"
        ],
        "id": "R13",
        "text": "A series matches a list item by TVDB id, IMDb id, TMDb id, MAL id or AniList id."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.TryCleanLibrary",
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.AllListsSuccessfulWithAPendingClean"
        ],
        "id": "R14",
        "text": "Library cleaning is skipped if the list sync level is Disabled. Otherwise it runs only when every automatic-add list has synced without being disabled and at least one has removed items since the last clean."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.ImportListSyncService.CleanLibrary"
        ],
        "id": "R15",
        "text": "For library series not on any list: LogOnly logs a message; KeepAndUnmonitor unmonitors monitored series; KeepAndTag adds the configured list-sync tag if missing."
      },
      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.ImportLists.FetchAndParseImportListService.Fetch",
