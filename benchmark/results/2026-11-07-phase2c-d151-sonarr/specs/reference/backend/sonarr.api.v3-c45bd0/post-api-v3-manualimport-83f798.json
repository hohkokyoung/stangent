      {
        "cites": [
          "Sonarr.Core|M:NzbDrone.Core.MediaFiles.EpisodeImport.Manual.ManualImportService.ReprocessItem(System.String,System.String,System.Int32,System.Nullable{System.Int32},System.Collections.Generic.List{System.Int32},System.String,NzbDrone.Core.Qualities.QualityModel,System.Collections.Generic.List{NzbDrone.Core.Languages.Language},System.Int32,NzbDrone.Core.Parser.Model.ReleaseType)"
        ],
        "id": "R6",
        "text": "When episode IDs are given, the file is evaluated against those episodes and the user-chosen series, episodes, release group, quality, languages, indexer flags and release type are reapplied after augmenting, before the import decision."
      },
      {
        "cites": [
