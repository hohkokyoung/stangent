        ],
        "id": "R3",
        "text": "If an item's languages are only Unknown (or one/none) and the reprocessed result has languages, the item's languages are replaced by the result's."
      },
      {
        "cites": [
          "Sonarr.Api.V3|M:Sonarr.Api.V3.ManualImport.ManualImportController.ReprocessItems(System.Collections.Generic.List{Sonarr.Api.V3.ManualImport.ManualImportReprocessResource})"
