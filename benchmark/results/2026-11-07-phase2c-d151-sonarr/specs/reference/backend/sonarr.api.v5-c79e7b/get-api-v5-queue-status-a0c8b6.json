    "shows": [
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S1",
        "text": "Returns a queue status object with TotalCount, Count, UnknownCount, Errors, Warnings, UnknownErrors and UnknownWarnings."
      },
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S2",
        "text": "TotalCount is the number of queue items plus the number of pending releases."
      },
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S3",
        "text": "Count is the number of queue items that have a series plus the number of pending releases."
      },
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S4",
        "text": "UnknownCount is the number of queue items with no series."
      },
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S5",
        "text": "Errors is true when any queue item with a series has tracked download status Error; Warnings is true likewise for status Warning."
      },
      {
        "cites": [
          "Sonarr.Api.V5|M:Sonarr.Api.V5.Queue.QueueStatusController.GetQueueStatus"
        ],
        "id": "S6",
        "text": "UnknownErrors and UnknownWarnings are true when any queue item with no series has tracked download status Error or Warning respectively."
      }
    ],
