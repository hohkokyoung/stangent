{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "agentic_mcp",
    "context7",
    "sequential-thinking"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/py .claude/hooks/pre_tool_use.py",
            "_agentic_managed": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/py .claude/hooks/post_tool_use.py",
            "_agentic_managed": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/py .claude/hooks/log_usage.py",
            "_agentic_managed": true
          },
          {
            "type": "command",
            "command": "sh .claude/py .claude/hooks/verify_review.py",
            "_agentic_managed": true
          }
        ]
      }
    ]
  }
}
