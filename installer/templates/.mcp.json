{
  "_comment": "MCP server definitions. agentic_mcp, context7 and sequential-thinking are enabled by default. To activate others, add their name to enabledMcpjsonServers in .claude/settings.json. dbhub and supabase need credentials filled in first; github authenticates over OAuth on first use, so no token is stored here.",
  "mcpServers": {
    "agentic_mcp": {
      "command": "python3",
      "args": [".claude/mcp/agentic_mcp.py"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "CONTEXT7_API_KEY": "OPTIONAL_set_if_you_hit_rate_limits_free_at_context7.com"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "maestro": {
      "command": "maestro",
      "args": ["mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--dsn",
        "REPLACE_WITH_DSN"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase",
        "--access-token", "REPLACE_WITH_SUPABASE_PAT",
        "--project-ref",  "REPLACE_WITH_PROJECT_REF"
      ]
    }
  }
}
